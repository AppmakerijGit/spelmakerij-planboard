    private void OpenPublishConfirmation()
    {
        if (IsPastDay) return;
        _publishHour = 7;
        _publishMinute = 0;
        Modal.Open(new ModalOptions(
            Title: "Zeker weten?",
            ConfirmLabel: "Publiceer",
            HideInput: true,
            Extra: BuildPublishExtra(),
            OnConfirm: async _ =>
            {
                DateTime? visibleFrom = _publishHour is { } h && _publishMinute is { } m
                    ? new DateTime(_selectedDate.Year, _selectedDate.Month, _selectedDate.Day, h, m, 0)
                    : null;
                _publishedAt = DateTime.Now;
                await Cards.PublishCards(DateKey, visibleFrom);
                Modal.Close();
                Toast.Show("Planning gepubliceerd");
                StateHasChanged();
            }
        ));
    }

