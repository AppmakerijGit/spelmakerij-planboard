    private async Task DropCard(string targetLocation, int targetSlotIdx)
    {
        if (IsPastDay || _cardDrag is null) return;
        if (_cardDrag.SourceSlotIdx != targetSlotIdx) return;

        if (string.Equals(_cardDrag.SourceLocation, targetLocation, StringComparison.OrdinalIgnoreCase))
            return;

        var sourceSlot = _slots[_cardDrag.SourceSlotIdx];
        if (_cardDrag.CardIdx >= sourceSlot.Count) return;

        var card = sourceSlot[_cardDrag.CardIdx];
        sourceSlot.RemoveAt(_cardDrag.CardIdx);
        card.Location = targetLocation;
        _slots[targetSlotIdx].Add(card);

        _cardDrag = null;
        ValidatePlanning();
        _publishedAt = null;
        StateHasChanged();
        await SaveSlots();
    }

