    private void OpenEditComposer(string location, int slotIdx, int cardIdx)
    {
        if (IsPastDay) return;
        var card = _slots[slotIdx][cardIdx];
        _activeSlot = slotIdx;
        _activeCell = (location, slotIdx);
        _editCard = (slotIdx, cardIdx);
        _draftGameId = _builderData?.Spellen.FirstOrDefault(g =>
            string.Equals(g.Name, card.Title, StringComparison.OrdinalIgnoreCase))?.Id;
        _draftSupervisorIds = _accounts
            .Where(a => (a.Role == "admin" || a.Role == "vrijwilliger") && card.Supers.Any(s =>
                string.Equals(s.Name, a.Name, StringComparison.OrdinalIgnoreCase)))
            .Select(a => a.Id)
            .ToHashSet();
        _draftParticipantIds = _accounts
            .Where(a => a.Role == "deelnemer" && card.Clients.Any(c =>
                string.Equals(c, a.Name, StringComparison.OrdinalIgnoreCase)))
            .Select(a => a.Id)
            .ToHashSet();
        _activityValidationMessage = null;
        _validationMessage = null;
