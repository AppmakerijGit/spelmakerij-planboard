@page "/calendar"
@attribute [Authorize(Roles = "admin")]
@inject CardService Cards
@inject BuilderService Builder
@inject AbsenceService AbsenceService
@inject AccountService AccountService
@inject AuthService Auth
@inject NavigationManager Nav
@inject ToastService Toast
@inject ModalService Modal
@inject IJSRuntime JS
@inject SlotTimesService SlotTimesService

<PageTitle>Agenda</PageTitle>

@if (_hoverTooltip is not null)
{
    <div class="badge-fixed-tooltip" style="left: @((int)_hoverTooltipX)px; top: @((int)_hoverTooltipY + 16)px">@_hoverTooltip</div>
}

<div class="screen active">
    <div class="agenda-editor">
        <div class="agenda-toolbar">
            <div class="agenda-toolbar-left">
                <span class="editor-mode-badge">Mode: Bewerken</span>
                <div class="agenda-date-picker">
                    <span aria-hidden="true">Cal</span>
                    <input type="date" @bind="_selectedDate" @bind:after="LoadCards" aria-label="Kies planningsdatum" />
                </div>
                <button class="agenda-today-btn" type="button" @onclick="GoToToday" aria-label="Ga naar vandaag">Vandaag</button>
                @if (_publishedAt is null)
                {
                    <span class="agenda-plan-indicator @(DayHasPlanning ? "has-plan" : "")">
                        @(DayHasPlanning ? "Planning aanwezig" : "Nog geen planning")
                    </span>
                }
                else
                {
                    <span class="agenda-plan-indicator published">
                        Gepubliceerd
                    </span>
                }
            </div>
            <div class="agenda-toolbar-actions">
                <button class="reorder-btn @(_isLocationReorderMode ? "active" : "")"
                        type="button"
                        disabled="@(_isSavingLocationOrder || LocationOrder.Count < 2)"
                        @onclick="ToggleLocationReorderMode">
                    @(_isLocationReorderMode ? "Ordenen annuleren" : "Locaties Ordenen")
                </button>
                @if (_isLocationReorderMode)
                {
                    <button class="reorder-save-btn"
                            type="button"
                            disabled="@(!HasLocationOrderChanges || _isSavingLocationOrder)"
                            @onclick="SaveLocationOrder">
                        @(_isSavingLocationOrder ? "Opslaan..." : "Opslaan als standaard")
                    </button>
                }
                <button class="reorder-btn @(_isTimeEditMode ? "active" : "")"
                        type="button"
                        disabled="@(_isSavingSlotTimes)"
                        @onclick="ToggleTimeEditMode">
                    @(_isTimeEditMode ? "Bewerken annuleren" : "Tijden bewerken")
                </button>
                @if (_isTimeEditMode)
                {
                    <button class="reorder-save-btn"
                            type="button"
                            disabled="@_isSavingSlotTimes"
                            @onclick="SaveSlotTimes">
                        @(_isSavingSlotTimes ? "Opslaan..." : "Opslaan")
                    </button>
                }
                @if (!_isLocationReorderMode && !_isTimeEditMode && !IsPastDay)
                {
                    <button class="publish-btn @(IsPlanningPublishable ? "ready" : "")"
                            type="button"
                            disabled="@(!IsPlanningPublishable)"
                            @onclick="OpenPublishConfirmation">
                        Publiceer
                    </button>
                }
            </div>
        </div>

        <div class="agenda-week-nav" aria-label="Week overzicht">
            <button class="week-nav-btn" type="button" @onclick="() => JumpDay(-7)" aria-label="Vorige week">←</button>
            @foreach (var day in GetCurrentWeekDays())
            {
                var isSelected = day == _selectedDate;
                var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                var status = _weekStatuses.FirstOrDefault(s => s.Date == day.ToString("yyyy-MM-dd"));
                var hasPlanning = status?.HasPlanning ?? false;
                var isPublished = status?.IsPublished ?? false;

                <button class="week-day-btn @(isSelected ? "active" : "") @(isToday ? "today" : "") @(isPublished ? "published" : hasPlanning ? "has-planning" : "")"
                        type="button"
                        @onclick="() => SelectDay(day)">
                    <span class="day-name">@FormatDayName(day)</span>
                    <span class="day-number">@day.Day</span>
                </button>
            }
            <button class="week-nav-btn" type="button" @onclick="() => JumpDay(7)" aria-label="Volgende week">→</button>
        </div>


        @if (AbsenceSummaries.Any())
        {
            <div class="absence-compact-row" aria-label="Compacte absentieweergave">
                @foreach (var summary in AbsenceSummaries)
                {
                    <span class="absence-compact-badge @summary.Type" title="@summary.Names">@summary.Label</span>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_validationMessage))
        {
            <div class="agenda-validation" role="alert">@_validationMessage</div>
        }

        <div class="agenda-body">
            <aside class="expected-panel" aria-label="Verwachte deelnemers">
                <div class="expected-panel-title">
                    Verwachte deelnemers
                    @if (_activeSlot != null)
                    {
                        <span class="active-slot-indicator">(@_slotTimes[_activeSlot.Value].PeriodLabel)</span>
                    }
                </div>
                <section class="expected-location">
                    <div class="expected-list">
                        @foreach (var participant in ExpectedParticipants)
                        {
                            var pName = participant.Name;
                            var pDragType = "client";
                            var scheduled = _activeSlot != null
                                ? IsParticipantScheduledInActiveSlot(participant.Name)
                                : IsParticipantScheduledAnywhere(participant.Name);
                            <span class="expected-person @(scheduled ? "scheduled" : "missing") @(IsOwnName(participant.Name) ? "own-name" : "")"
                                  draggable="@(!IsPastDay ? "true" : "false")"
                                  @ondragstart="() => StartPanelDrag(pDragType, pName)"
                                  @ondragend="EndPanelDrag">
                                @participant.Name
                                @if (scheduled)
                                {
                                    <small>Ingepland</small>
                                }
                            </span>
                        }
                    </div>
                </section>

                <section class="expected-location">
                    <div class="expected-panel-title">Verwachte begeleiders</div>
                    <div class="expected-list">
                        @foreach (var supervisor in AvailableSupervisors)
                        {
                            var sName = supervisor.Name;
                            var sDragType = "supervisor";
                            var scheduledSup = _activeSlot != null
                                ? IsSupervisorScheduledAtTime(supervisor.Name, _activeSlot.Value)
                                : IsSupervisorScheduledAnywhere(supervisor.Name);
                            <span class="expected-person @(scheduledSup ? "scheduled" : "missing") @(IsOwnName(supervisor.Name) ? "own-name" : "")"
                                  draggable="@(!IsPastDay ? "true" : "false")"
                                  @ondragstart="() => StartPanelDrag(sDragType, sName)"
                                  @ondragend="EndPanelDrag">
                                @supervisor.Name
                                @if (scheduledSup)
                                {
                                    <small>Ingepland</small>
                                }
                            </span>
                        }
                    </div>
                </section>

            </aside>

            <div class="agenda-grid-wrap">
                <div class="agenda-matrix">
                    <div class="matrix-corner">
                        <span>Locaties</span>
                        <small>volgorde</small>
                    </div>

                    @for (int s = 0; s < _slotTimes.Count; s++)
                    {
                        var headerSlotIdx = s;
                        <div class="matrix-time-header @(headerSlotIdx == _activeSlot ? "active" : "")" @onclick="() => { if (!_isTimeEditMode) SelectSlot(headerSlotIdx); }" style="cursor: @(_isTimeEditMode ? "default" : "pointer");">
                            @if (_isTimeEditMode)
                            {
                                <input class="slot-edit-input" @bind="_slotTimes[headerSlotIdx].TimeRange" @onclick:stopPropagation />
                                <input class="slot-edit-input period" @bind="_slotTimes[headerSlotIdx].PeriodLabel" @onclick:stopPropagation />
                            }
                            else
                            {
                                <div class="slot-cell-time" title="@_slotTimes[headerSlotIdx].TimeRange">@_slotTimes[headerSlotIdx].TimeRange</div>
                                <div class="slot-cell-period">@_slotTimes[headerSlotIdx].PeriodLabel</div>
                            }
                            <div class="ch-line"></div>
                        </div>
                    }

                    @for (int i = 0; i < LocationOrder.Count; i++)
                    {
                        var locationIdx = i;
                        var location = LocationOrder[locationIdx];
                        <div class="matrix-location-header @(IsLocationIncomplete(location) ? "incomplete" : "") @(IsDraggingLocation(locationIdx) ? "dragging" : "") @(IsLocationDropTarget(locationIdx) ? "drop-target" : "") @(_isLocationReorderMode ? "reorder-enabled" : "")"
                             draggable="@(_isLocationReorderMode ? "true" : "false")"
                             @ondragstart="() => StartLocationDrag(locationIdx)"
                             @ondragend="ClearLocationDrag"
                             @ondragover:preventDefault
                             @ondragover="() => SetLocationDropTarget(locationIdx)"
                             @ondrop="() => DropLocation(locationIdx)">
                            <div>
                                <div class="location-header-kicker">
                                    Locatie
                                </div>
                                <div class="location-header-name">@location</div>
                            </div>
                            @if (_isLocationReorderMode)
                            {
                                <div class="location-order-actions">
                                    <button class="location-order-btn"
                                            type="button"
                                            disabled="@(locationIdx == 0)"
                                            @onclick="() => MoveLocation(locationIdx, locationIdx - 1)"
                                            @onclick:stopPropagation
                                            aria-label="Locatie omhoog">
                                        Omhoog
                                    </button>
                                    <button class="location-order-btn"
                                            type="button"
                                            disabled="@(locationIdx == LocationOrder.Count - 1)"
                                            @onclick="() => MoveLocation(locationIdx, locationIdx + 1)"
                                            @onclick:stopPropagation
                                            aria-label="Locatie omlaag">
                                        Omlaag
                                    </button>
                                </div>
                            }
                        </div>

                        @for (int s = 0; s < _slotTimes.Count; s++)
                        {
                            var slotIdx = s;
                            <div class="location-slot-cell matrix-slot-cell @(IsActiveCell(location, slotIdx) ? "active" : "") @(IsLocationDropTarget(locationIdx) ? "drop-target" : "") @(IsValidTagDropTarget(location, slotIdx) || IsValidCardDropTarget(location, slotIdx) || IsPanelDragDropTarget(location, slotIdx) ? "tag-drop-target" : "") @(IsPastDay ? "past-day-cell" : "")"
                                 @ondragover:preventDefault
                                 @ondragover="() => SetLocationDropTarget(locationIdx)"
                                 @ondrop="() => HandleCellDrop(location, slotIdx, locationIdx)">
                                <div class="slot-cell-top">
                                    <div>
                                        <div class="slot-cell-time" title="@_slotTimes[slotIdx].TimeRange">@_slotTimes[slotIdx].TimeRange</div>
                                        <div class="slot-cell-period">@_slotTimes[slotIdx].PeriodLabel</div>
                                    </div>
                                    @if (!IsPastDay)
                                    {
                                        <button class="slot-add-btn" type="button"
                                                @onclick="() => OpenActivityComposer(location, slotIdx)"
                                                @onclick:stopPropagation
                                                aria-label="Activiteit toevoegen">+</button>
                                    }
                                </div>

                                @foreach (var card in CardsFor(location, slotIdx))
                                {
                                    var cardIdx = _slots[slotIdx].IndexOf(card);
                                    var cardTitle = card.Title;
                                    var cardLocation = location;
                                    var cardSlot = slotIdx;
                                    var tagGame = "game";
                                    var tagClient = "client";
                                    var tagSupervisor = "supervisor";
                                    <div class="admin-card @(IsDraggingCard(cardLocation, cardSlot, cardIdx) ? "card-dragging" : "")"
                                         draggable="@(!IsPastDay ? "true" : "false")"
                                         @ondragstart="() => StartCardDrag(cardLocation, cardSlot, cardIdx)"
                                         @ondragend="EndCardDrag">
                                        <div class="activity-card">
                                            <div class="card-main">
                                                <div class="card-tags">
                                                    <span class="tag game @(IsDraggingTag(tagGame, cardLocation, cardSlot, cardTitle) ? "tag-dragging" : "")"
                                                          draggable="@(!IsPastDay ? "true" : "false")"
                                                          @ondragstart:stopPropagation
                                                          @ondragstart="() => StartTagDrag(tagGame, cardLocation, cardSlot, cardTitle)"
                                                          @ondragend="EndTagDrag">
                                                        @cardTitle
                                                    </span>
                                                </div>
                                                <div class="card-divider-left"></div>
                                                <div class="card-tags">
                                                    @foreach (var client in card.Clients)
                                                    {
                                                        var c = client;
                                                        var cardPlayCount = GetCardPlayCount(c, card.Title);
                                                        var cardConflicts = GetCardExclusivityConflicts(c, card.Clients);
                                                        <span class="chip-wrapper">
                                                            <span class="tag deelnemer @(IsOwnName(c) ? "own-name" : "") @(IsDraggingTag(tagClient, cardLocation, cardSlot, c) ? "tag-dragging" : "")"
                                                                  draggable="@(!IsPastDay ? "true" : "false")"
                                                                  @ondragstart:stopPropagation
                                                                  @ondragstart="() => StartTagDrag(tagClient, cardLocation, cardSlot, c)"
                                                                  @ondragend="EndTagDrag">
                                                                @c
                                                            </span>
                                                            @if (cardPlayCount > 0)
                                                            {
                                                                var cardCountTip = $"{c} heeft dit spel al {cardPlayCount} keer gespeeld in de afgelopen twee weken";
                                                                <span class="chip-badge chip-badge--count"
                                                                      draggable="false"
                                                                      @ondragstart:stopPropagation
                                                                      @onmouseenter="(e) => OnBadgeMouseEnter(e, cardCountTip)"
                                                                      @onmouseleave="OnBadgeMouseLeave">
                                                                    @cardPlayCount
                                                                </span>
                                                            }
                                                            @if (cardConflicts.Count > 0)
                                                            {
                                                                var cardNames = string.Join(", ", cardConflicts);
                                                                var cardWarnTip = $"{c} staat op exclusief met: {cardNames}";
                                                                <span class="chip-badge chip-badge--warn"
                                                                      draggable="false"
                                                                      @ondragstart:stopPropagation
                                                                      @onmouseenter="(e) => OnBadgeMouseEnter(e, cardWarnTip)"
                                                                      @onmouseleave="OnBadgeMouseLeave">
                                                                    ⚠
                                                                </span>
                                                            }
                                                        </span>
                                                    }
                                                </div>
                                                @if (card.Supers.Any())
                                                {
                                                    <div class="card-divider-left"></div>
                                                    <div class="card-tags">
                                                        @foreach (var sup in card.Supers)
                                                        {
                                                            var supVar = sup;
                                                            <span class="tag @supVar.Type @(IsDraggingTag(tagSupervisor, cardLocation, cardSlot, supVar.Name) ? "tag-dragging" : "")"
                                                                  draggable="@(!IsPastDay ? "true" : "false")"
                                                                  @ondragstart:stopPropagation
                                                                  @ondragstart="() => StartTagDrag(tagSupervisor, cardLocation, cardSlot, supVar.Name)"
                                                                  @ondragend="EndTagDrag">
                                                                @supVar.Name
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        @if (!IsPastDay)
                                        {
                                            <button class="card-edit-btn" type="button"
                                                    @onclick="() => OpenEditComposer(location, slotIdx, cardIdx)"
                                                    @onclick:stopPropagation
                                                    aria-label="Bewerk activiteit">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                </svg>
                                            </button>
                                            <button class="card-delete-btn" type="button"
                                                    @onclick="() => DeleteCard(slotIdx, cardIdx)"
                                                    @onclick:stopPropagation
                                                    aria-label="Verwijder planning">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6l-1 14H6L5 6"/>
                                                    <path d="M10 11v6M14 11v6"/>
                                                    <path d="M9 6V4h6v2"/>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                }

                                @if (!CardsFor(location, slotIdx).Any())
                                {
                                    <div class="cards-empty slot-empty">Klik op + om activiteit te maken</div>
                                }

                            </div>
                        }
                    }
                </div>
            </div>

            @if (_activeCell is { } active)
            {
                <div class="composer-overlay" @onclick="CloseActivityComposer">
                    @RenderActivityComposer(active.Location, active.Slot)
                </div>
            }

            <aside class="sidebar agenda-builder-sidebar">
                <div class="builder-panel">
                    @if (_builderData is not null)
                    {
                        @RenderBuilderSection("Spellen", "spellen", _builderData.Spellen)
                        @RenderBuilderSection("Locaties", "locaties", _builderData.Locaties)
                    }
                </div>
            </aside>
        </div>
    </div>
</div>

@code {
    private List<SlotTime> _slotTimes = [];
    private List<SlotTime> _savedSlotTimes = [];
    private bool _isTimeEditMode;
    private bool _isSavingSlotTimes;

    private List<List<SlotCard>> _slots = EmptySlots();
    private DateTime? _slotsUpdatedAt;
    private BuilderData? _builderData;
    private List<Account> _accounts = [];
    private List<Absence> _selectedDateAbsences = [];
    private List<string> _locationOrder = [];
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private (string Location, int Slot)? _activeCell;
    private int? _activeSlot;
    private int? _dragLocationIndex;
    private int? _dropLocationIndex;
    private TagDrag? _tagDrag;
    private CardDrag? _cardDrag;
    private TagDrag? _pendingTagDrag;
    private PanelDrag? _panelDrag;
    private bool _isLocationReorderMode;
    private bool _isSavingLocationOrder;
    private int? _draftGameId;
    private HashSet<int> _draftSupervisorIds = [];
    private HashSet<int> _draftParticipantIds = [];
    private (int Slot, int CardIndex)? _editCard;
    private string? _activityValidationMessage;
    private string? _validationMessage;
    private DateTime? _publishedAt;
    private int? _publishHour;
    private int? _publishMinute;
    private List<PublishedDay> _publishedDays = [];
    private List<string> _savedLocationOrder = [];
    private List<DayStatus> _weekStatuses = [];
    private List<RecentGameEntry> _recentGames = [];
    private string? _badgeTooltip;
    private string _badgeTooltipClass = "composer-caution";
    private string? _hoverTooltip;
    private double _hoverTooltipX;
    private double _hoverTooltipY;
    private CancellationTokenSource? _tooltipCts;

    private void ToggleCountBadge(string tip)
    {
        _badgeTooltipClass = "composer-caution";
        _badgeTooltip = _badgeTooltip == tip ? null : tip;
    }

    private void ToggleWarnBadge(string tip)
    {
        _badgeTooltipClass = "composer-caution-orange";
        _badgeTooltip = _badgeTooltip == tip ? null : tip;
    }

    private async Task OnBadgeMouseEnter(MouseEventArgs e, string tip)
    {
        _tooltipCts?.Cancel();
        _tooltipCts?.Dispose();
        _tooltipCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(500, _tooltipCts.Token);
            _hoverTooltip = tip;
            _hoverTooltipX = e.ClientX;
            _hoverTooltipY = e.ClientY;
        }
        catch (OperationCanceledException) { }
    }

    private void OnBadgeMouseLeave(MouseEventArgs _)
    {
        _tooltipCts?.Cancel();
        _hoverTooltip = null;
    }

    private int GetCardPlayCount(string clientName, string gameTitle) =>
        _recentGames.Count(r =>
            string.Equals(r.ClientName, clientName, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(r.GameTitle, gameTitle, StringComparison.OrdinalIgnoreCase));

    private List<string> GetCardExclusivityConflicts(string clientName, IList<string> cardClients)
    {
        var account = _accounts.FirstOrDefault(a => string.Equals(a.Name, clientName, StringComparison.OrdinalIgnoreCase));
        if (account is null) return [];
        return _accounts
            .Where(a => cardClients.Any(c => string.Equals(c, a.Name, StringComparison.OrdinalIgnoreCase))
                        && !string.Equals(a.Name, clientName, StringComparison.OrdinalIgnoreCase)
                        && account.ExclusiveWith.Contains(a.Id))
            .Select(a => a.Name)
            .ToList();
    }

    private bool IsPastDay => _selectedDate < DateOnly.FromDateTime(DateTime.Today);
    private string DateKey => _selectedDate.ToString("yyyy-MM-dd");
    private bool DayHasPlanning => _slots.Any(slot => slot.Any());
    private bool IsPlanningPublishable => DayHasPlanning && string.IsNullOrWhiteSpace(_validationMessage);

    private IEnumerable<string> RecentGameWarnings
    {
        get
        {
            if (_draftGameId is null || _builderData is null)
                yield break;

            var gameTitle = _builderData.Spellen
                .FirstOrDefault(g => g.Id == _draftGameId)?.Name;
            if (gameTitle is null)
                yield break;

            var selectedNames = _accounts
                .Where(a => _draftParticipantIds.Contains(a.Id))
                .Select(a => a.Name)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            foreach (var name in selectedNames)
            {
                if (_recentGames.Any(r =>
                        string.Equals(r.ClientName, name, StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(r.GameTitle, gameTitle, StringComparison.OrdinalIgnoreCase)))
                {
                    yield return $"{name} heeft {gameTitle} al gespeeld in de afgelopen twee weken";
                }
            }
        }
    }

    private IEnumerable<string> ExclusivityWarnings
    {
        get
        {
            var selected = _accounts
                .Where(a => _draftParticipantIds.Contains(a.Id))
                .ToList();

            var reported = new HashSet<(int, int)>();
            foreach (var p in selected)
            {
                foreach (var exId in p.ExclusiveWith)
                {
                    var partner = selected.FirstOrDefault(a => a.Id == exId);
                    if (partner is null) continue;

                    var key = p.Id < exId ? (p.Id, exId) : (exId, p.Id);
                    if (reported.Add(key))
                        yield return $"Let op: {p.Name} en {partner.Name}  staan op elkaars exclusieve lijst";
                }
            }
        }
    }

    private string? DraftGameTitle =>
        _draftGameId is null || _builderData is null
            ? null
            : _builderData.Spellen.FirstOrDefault(g => g.Id == _draftGameId)?.Name;

    private int GetGamePlayCount(string clientName)
    {
        var gameTitle = DraftGameTitle;
        if (gameTitle is null) return 0;
        return _recentGames.Count(r =>
            string.Equals(r.ClientName, clientName, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(r.GameTitle, gameTitle, StringComparison.OrdinalIgnoreCase));
    }

    private List<string> GetExclusivityConflicts(int participantId)
    {
        var account = _accounts.FirstOrDefault(a => a.Id == participantId);
        if (account is null) return [];
        return _accounts
            .Where(a => _draftParticipantIds.Contains(a.Id) && a.Id != participantId && account.ExclusiveWith.Contains(a.Id))
            .Select(a => a.Name)
            .ToList();
    }

    private bool HasLocationRestriction(int participantId, string locationName)
    {
        if (_builderData is null) return false;
        var locationId = _builderData.Locaties
            .FirstOrDefault(l => string.Equals(l.Name, locationName, StringComparison.OrdinalIgnoreCase))?.Id;
        if (locationId is null) return false;
        var account = _accounts.FirstOrDefault(a => a.Id == participantId);
        return account?.LocationRestrictions.Contains(locationId.Value) == true;
    }

    private IReadOnlyList<string> LocationOrder => _locationOrder.Count > 0 ? _locationOrder : ["Zonder locatie"];
    private bool HasLocationOrderChanges => !_locationOrder.SequenceEqual(_savedLocationOrder, StringComparer.OrdinalIgnoreCase);

    private bool IsAvailableOnSelectedDay(Account account)
    {
        if (account.Availability is null || account.Availability.Count == 0)
            return true;

        var dayKey = _selectedDate.DayOfWeek.ToString().ToLower();
        return account.Availability.TryGetValue(dayKey, out var available) && available;
    }

    private bool IsAvailableInActiveSlot(Account account)
    {
        if (_activeSlot is null)
            return true;
        if (account.SlotAvailability is null)
            return true;

        var dayKey = _selectedDate.DayOfWeek.ToString().ToLower();
        if (!account.SlotAvailability.TryGetValue(dayKey, out var slots))
            return true;
        if (slots is null || slots.Length <= _activeSlot.Value)
            return true;

        return slots[_activeSlot.Value];
    }

    private IEnumerable<Account> AvailableParticipants =>
        _accounts
            .Where(account => account is { Role: "deelnemer", Active: true })
            .Where(participant => !_selectedDateAbsences.Any(absence =>
                string.Equals(absence.Name, participant.Name, StringComparison.OrdinalIgnoreCase)))
            .Where(IsAvailableOnSelectedDay)
            .Where(IsAvailableInActiveSlot);

    private IEnumerable<Account> ExpectedParticipants =>
        _accounts.Where(account => account is { Role: "deelnemer", Active: true } &&
                                    !_selectedDateAbsences.Any(absence =>
                                        string.Equals(absence.Name, account.Name, StringComparison.OrdinalIgnoreCase)))
            .Where(IsAvailableOnSelectedDay)
            .Where(IsAvailableInActiveSlot);

    private bool IsParticipantScheduledInActiveSlot(string participantName)
    {
        if (_activeSlot == null) return false;
        return IsParticipantScheduledAtTime(participantName, _activeSlot.Value);
    }

    private IEnumerable<Account> AvailableSupervisors =>
        _accounts.Where(account => account is { Active: true } && (account.Role == "admin" || account.Role == "vrijwilliger"))
            .Where(supervisor => !_selectedDateAbsences.Any(absence =>
                string.Equals(absence.Name, supervisor.Name, StringComparison.OrdinalIgnoreCase)))
            .Where(IsAvailableOnSelectedDay)
            .Where(IsAvailableInActiveSlot);

    private bool IsAbsentOnSelectedDay(string name) =>
        _selectedDateAbsences.Any(absence =>
            string.Equals(absence.Name, name, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<Absence> UnavailableParticipants =>
        _selectedDateAbsences
            .OrderBy(absence => absence.Name, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<AbsenceSummary> AbsenceSummaries =>
        _selectedDateAbsences
            .Where(a => a.Type != "ziek" && a.Type != "vakantie")
            .GroupBy(absence => absence.Type)
            .Select(group => new AbsenceSummary(
                group.Key,
                $"{AbsenceLabel(group.Key)}: {group.Count()} {(group.Count() == 1 ? "dag" : "dagen")}",
                string.Join(", ", group.Select(absence => absence.Name))));

    protected override async Task OnInitializedAsync()
    {
        if (Auth.CurrentUser is null || !Auth.CurrentUser.EditorEnabled)
        {
            Nav.NavigateTo("/dashboard");
            return;
        }

        _slotTimes = await SlotTimesService.GetSlotTimes();
        _savedSlotTimes = _slotTimes.Select(s => new SlotTime { Id = s.Id, SortOrder = s.SortOrder, TimeRange = s.TimeRange, PeriodLabel = s.PeriodLabel }).ToList();
        await LoadCards();
    }

    private async Task LoadCards()
    {
        var planTask = Cards.GetDayPlan(DateKey);
        var builderTask = Builder.GetBuilderData();
        var absencesTask = AbsenceService.GetAbsences(DateKey);
        var accountsTask = AccountService.GetAccounts();

        var diff = (7 + (_selectedDate.DayOfWeek - DayOfWeek.Monday)) % 7;
        var startOfWeek = _selectedDate.AddDays(-1 * diff);
        var endOfWeek = startOfWeek.AddDays(4);

        var weekStatusesTask = Cards.GetDayStatuses(
            startOfWeek.ToString("yyyy-MM-dd"),
            endOfWeek.ToString("yyyy-MM-dd"));

        var from = _selectedDate.AddDays(-13).ToString("yyyy-MM-dd");
        var to   = _selectedDate.AddDays(-1).ToString("yyyy-MM-dd");
        var recentGamesTask = Cards.GetRecentGames(from, to);

        var monthStart = new DateOnly(_selectedDate.Year, _selectedDate.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);
        var publishedDaysTask = Cards.GetPublishedDays(
            monthStart.ToString("yyyy-MM-dd"),
            monthEnd.ToString("yyyy-MM-dd"));

        await Task.WhenAll(planTask, builderTask, absencesTask, accountsTask, publishedDaysTask, weekStatusesTask, recentGamesTask);

        var plan = planTask.Result;
        _slots = NormalizeSlots(plan.Slots);
        _slotsUpdatedAt = plan.UpdatedAt;
        _publishedAt = plan.PublishedAt;
        _publishedDays = publishedDaysTask.Result;
        _weekStatuses = weekStatusesTask.Result;
        _recentGames = recentGamesTask.Result;
        _builderData = builderTask.Result;
        _selectedDateAbsences = absencesTask.Result;
        _accounts = accountsTask.Result;
        _locationOrder = BuildLocationOrder();
        _savedLocationOrder = [.. _locationOrder];
        _isLocationReorderMode = false;
        _isSavingLocationOrder = false;
        _activeCell = null;
        ClearLocationDrag();
        _tagDrag = null;
        _cardDrag = null;
        _pendingTagDrag = null;
        _panelDrag = null;
        ValidatePlanning();
    }

    private async Task JumpDay(int days)
    {
        _selectedDate = _selectedDate.AddDays(days);
        await LoadCards();
    }

    private async Task GoToToday()
    {
        _selectedDate = DateOnly.FromDateTime(DateTime.Today);
        await LoadCards();
    }

    private async Task SelectDay(DateOnly day)
    {
        _selectedDate = day;
        await LoadCards();
    }

    private IEnumerable<DateOnly> GetCurrentWeekDays()
    {
        int diff = (7 + (_selectedDate.DayOfWeek - DayOfWeek.Monday)) % 7;
        var startOfWeek = _selectedDate.AddDays(-1 * diff);

        for (int i = 0; i < 5; i++)
        {
            yield return startOfWeek.AddDays(i);
        }
    }

    private string FormatDayName(DateOnly date)
    {
        var days = new[] { "Zo", "Ma", "Di", "Wo", "Do", "Vr", "Za" };
        return days[(int)date.DayOfWeek];
    }

    private async Task SelectPublishedDay(string date)
    {
        if (!TryParseDateKey(date, out var selectedDate))
            return;

        _selectedDate = selectedDate;
        await LoadCards();
    }

