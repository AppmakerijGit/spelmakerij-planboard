    private async Task HandleCellDrop(string location, int slotIdx, int locationIdx)
    {
        if (_isLocationReorderMode)
        {
            DropLocation(locationIdx);
            return;
        }
        if (_tagDrag is not null)
        {
            var isEmpty = !CardsFor(location, slotIdx).Any();
            if (isEmpty && _tagDrag.Type is "client" or "supervisor")
                TryOpenComposerFromTagDrag(location, slotIdx);
            else
                await DropTag(location, slotIdx);
        }
        else if (_cardDrag is not null)
            await DropCard(location, slotIdx);
        else if (_panelDrag is not null)
            await HandlePanelDrop(location, slotIdx);
    }

    private async Task HandlePanelDrop(string location, int slotIdx)
    {
        if (IsPastDay || _panelDrag is null) return;

        if (_panelDrag.Type == "game")
        {
            var gameCard = CardsFor(location, slotIdx).FirstOrDefault();
            if (gameCard is null)
            {
                OpenActivityComposer(location, slotIdx);
                var game = _builderData?.Spellen.FirstOrDefault(g =>
                    string.Equals(g.Name, _panelDrag.Value, StringComparison.OrdinalIgnoreCase));
                if (game is not null)
                    _draftGameId = game.Id;
            }
            else
            {
                gameCard.Title = _panelDrag.Value;
                ValidatePlanning();
                _publishedAt = null;
                StateHasChanged();
                await SaveSlots();
            }
            _panelDrag = null;
            return;
        }

        if (IsAbsentOnSelectedDay(_panelDrag.Value))
        {
            Toast.Show($"{_panelDrag.Value} is afwezig en kan niet worden ingepland.");
            _panelDrag = null;
            return;
        }

        var card = CardsFor(location, slotIdx).FirstOrDefault();
        if (card is null)
        {
            OpenActivityComposer(location, slotIdx);
            var account = _accounts.FirstOrDefault(a =>
                string.Equals(a.Name, _panelDrag.Value, StringComparison.OrdinalIgnoreCase));
            if (account is not null)
            {
                if (_panelDrag.Type == "client")
                    _draftParticipantIds = [account.Id];
                else
                    _draftSupervisorIds = [account.Id];
            }
            _panelDrag = null;
            return;
        }

        if (_panelDrag.Type == "client")
        {
            if (card.Clients.Any(c => string.Equals(c, _panelDrag.Value, StringComparison.OrdinalIgnoreCase)))
            {
                Toast.Show($"{_panelDrag.Value} staat al op deze activiteit.");
                _panelDrag = null;
                return;
            }
            card.Clients.Add(_panelDrag.Value);
        }
        else
        {
            if (card.Supers.Any(s => string.Equals(s.Name, _panelDrag.Value, StringComparison.OrdinalIgnoreCase)))
            {
                Toast.Show($"{_panelDrag.Value} staat al op deze activiteit.");
                _panelDrag = null;
                return;
            }
            var account = _accounts.FirstOrDefault(a =>
                string.Equals(a.Name, _panelDrag.Value, StringComparison.OrdinalIgnoreCase));
            card.Supers.Add(new Supervisor { Name = _panelDrag.Value, Type = account?.Type ?? "sup-blue" });
        }

        _panelDrag = null;
        ValidatePlanning();
        _publishedAt = null;
        StateHasChanged();
        await SaveSlots();
    }

    private void TryOpenComposerFromTagDrag(string location, int slotIdx)
    {
        if (_tagDrag is null) return;

        if (_tagDrag.Type is "client" or "supervisor" && IsAbsentOnSelectedDay(_tagDrag.Value))
        {
            Toast.Show($"{_tagDrag.Value} is afwezig en kan niet worden ingepland.");
            _tagDrag = null;
            return;
        }

        var sourceCard = _slots[_tagDrag.SlotIdx].FirstOrDefault(c =>
            string.Equals(c.Location, _tagDrag.SourceLocation, StringComparison.OrdinalIgnoreCase));
        if (sourceCard is null) return;

        var canRemove = _tagDrag.Type == "client"
            ? CardConstraints.CanRemoveClient(sourceCard)
            : CardConstraints.CanRemoveSupervisor(sourceCard);
        if (!canRemove) return;

        _pendingTagDrag = _tagDrag;
        _tagDrag = null;

        OpenActivityComposer(location, slotIdx);

        if (_pendingTagDrag.Type == "client")
        {
            var account = _accounts.FirstOrDefault(a =>
                string.Equals(a.Name, _pendingTagDrag.Value, StringComparison.OrdinalIgnoreCase));
            if (account is not null)
                _draftParticipantIds = [account.Id];
        }
        else
        {
            var account = _accounts.FirstOrDefault(a =>
                string.Equals(a.Name, _pendingTagDrag.Value, StringComparison.OrdinalIgnoreCase));
            if (account is not null)
                _draftSupervisorIds = [account.Id];
        }
    }

    private void MoveLocation(int sourceIdx, int targetIdx)
    {
        if (sourceIdx == targetIdx
            || sourceIdx < 0
            || targetIdx < 0
            || sourceIdx >= _locationOrder.Count
            || targetIdx >= _locationOrder.Count)
        {
            return;
        }

        var item = _locationOrder[sourceIdx];
        _locationOrder.RemoveAt(sourceIdx);
        _locationOrder.Insert(targetIdx, item);
    }

    private void ToggleTimeEditMode()
    {
        if (_isTimeEditMode)
        {
            // Cancel: restore from snapshot
            _slotTimes = _savedSlotTimes.Select(s => new SlotTime { Id = s.Id, SortOrder = s.SortOrder, TimeRange = s.TimeRange, PeriodLabel = s.PeriodLabel }).ToList();
        }
        _isTimeEditMode = !_isTimeEditMode;
    }

    private async Task SaveSlotTimes()
    {
        if (_slotTimes.Any(s => string.IsNullOrWhiteSpace(s.TimeRange) || string.IsNullOrWhiteSpace(s.PeriodLabel)))
        {
            Toast.Show("Vul alle tijden en labels in voor je opslaat.");
            return;
        }
        _isSavingSlotTimes = true;
        try
        {
            await SlotTimesService.SaveSlotTimes(_slotTimes);
            _savedSlotTimes = _slotTimes.Select(s => new SlotTime { Id = s.Id, SortOrder = s.SortOrder, TimeRange = s.TimeRange, PeriodLabel = s.PeriodLabel }).ToList();
            _isTimeEditMode = false;
            Toast.Show("Tijden opgeslagen");
        }
        finally
        {
            _isSavingSlotTimes = false;
        }
    }

    private void ToggleLocationReorderMode()
    {
        if (_isLocationReorderMode)
        {
            _locationOrder = [.. _savedLocationOrder];
            _isLocationReorderMode = false;
            ClearLocationDrag();
            return;
        }

        _isLocationReorderMode = true;
    }

    private async Task SaveSlots()
    {
        try
        {
            _slotsUpdatedAt = await Cards.SaveCards(DateKey, _slots, _slotsUpdatedAt);
        }
        catch (PlanningConflictException ex)
        {
            Toast.Show(ex.Message);
        }
    }

    private async Task SaveLocationOrder()
    {
        if (_builderData is null)
            return;

        var orderedLocationIds = _locationOrder
            .Select(locationName => _builderData.Locaties.FirstOrDefault(location =>
                string.Equals(location.Name, locationName, StringComparison.OrdinalIgnoreCase)))
            .Where(location => location is not null)
            .Select(location => location!.Id)
            .Distinct()
            .ToList();

        if (!orderedLocationIds.Any())
            return;

        _isSavingLocationOrder = true;

        try
        {
            await Builder.ReorderItems("locaties", orderedLocationIds);

            var locationLookup = _builderData.Locaties.ToDictionary(location => location.Id);
            _builderData.Locaties = orderedLocationIds
                .Where(locationLookup.ContainsKey)
                .Select(id => locationLookup[id])
                .ToList();

            _locationOrder = BuildLocationOrder();
            _savedLocationOrder = [.. _locationOrder];
            _isLocationReorderMode = false;
            ClearLocationDrag();
            Toast.Show("Standaardvolgorde opgeslagen");
        }
        finally
        {
            _isSavingLocationOrder = false;
        }
    }

