    private RenderFragment RenderActivityComposer(string location, int slotIdx) => __builder =>
    {
        <div class="activity-composer" @onclick:stopPropagation>
            <div class="activity-composer-head">
                <div>
                    <h3>@(_editCard is not null ? "Activiteit bewerken" : "Nieuwe activiteit")</h3>
                    <span>@location - @_slotTimes[slotIdx].TimeRange (@_slotTimes[slotIdx].PeriodLabel)</span>
                </div>
                <button class="composer-close-btn" type="button" @onclick="CloseActivityComposer" aria-label="Venster sluiten">x</button>
            </div>

            <section class="composer-section">
                <div class="composer-label">Spel</div>
                <div class="composer-chip-list">
                    @foreach (var game in _builderData?.Spellen ?? [])
                    {
                        var selected = _draftGameId == game.Id;
                        <button class="composer-chip game @(selected ? "selected" : "")"
                                type="button"
                                @onclick="() => _draftGameId = game.Id">@game.Name</button>
                    }
                </div>
            </section>

            <section class="composer-section">
                <div class="composer-label">Begeleiders</div>
                <div class="composer-chip-list">
                    @foreach (var supervisor in AvailableSupervisors)
                    {
                        var selected = _draftSupervisorIds.Contains(supervisor.Id);
                        var isBeingDraggedSup = _pendingTagDrag is { Type: "supervisor" } pds &&
                            string.Equals(pds.Value, supervisor.Name, StringComparison.OrdinalIgnoreCase);
                        var alreadyAtTime = !isBeingDraggedSup && (_editCard is { } ec && ec.Slot == slotIdx
                            ? _slots.Count > slotIdx && _slots[slotIdx]
                                .Where((_, idx) => idx != ec.CardIndex)
                                .Any(card => card.Supers.Any(s => string.Equals(s.Name, supervisor.Name, StringComparison.OrdinalIgnoreCase)))
                            : IsSupervisorScheduledAtTime(supervisor.Name, slotIdx));
                        <button class="composer-chip @(supervisor.Type == "sup-green" ? "sup-green" : "sup-blue") @(selected ? "selected" : "")"
                                type="button"
                                disabled="@alreadyAtTime"
                                title="@(alreadyAtTime ? "Deze begeleider is al ingepland op dit moment" : null)"
                                @onclick="() => ToggleDraftSupervisor(supervisor.Id)">
                            @supervisor.Name
                            @if (alreadyAtTime)
                            {
                                <small>al ingepland</small>
                            }
                        </button>
                    }
                </div>
            </section>

            <section class="composer-section">
                <div class="composer-label">Deelnemers</div>
                <div class="composer-chip-list scroll">
                    @foreach (var participant in AvailableParticipants)
                    {
                        var selected = _draftParticipantIds.Contains(participant.Id);
                        var isBeingDraggedClient = _pendingTagDrag is { Type: "client" } pdc &&
                            string.Equals(pdc.Value, participant.Name, StringComparison.OrdinalIgnoreCase);
                        var alreadyAtTime = !isBeingDraggedClient && (_editCard is { } ec && ec.Slot == slotIdx
                            ? _slots.Count > slotIdx && _slots[slotIdx]
                                .Where((_, idx) => idx != ec.CardIndex)
                                .Any(card => card.Clients.Any(c => string.Equals(c, participant.Name, StringComparison.OrdinalIgnoreCase)))
                            : IsParticipantScheduledAtTime(participant.Name, slotIdx));
                        var playCount = GetGamePlayCount(participant.Name);
                        var conflicts = GetExclusivityConflicts(participant.Id);
                        var locationBlock = HasLocationRestriction(participant.Id, location);
                        <span class="chip-wrapper">
                            <button class="composer-chip deelnemer @(selected ? "selected" : "") @(IsOwnName(participant.Name) ? "own-name" : "")"
                                    type="button"
                                    disabled="@alreadyAtTime"
                                    title="@(alreadyAtTime ? "Deze deelnemer is al ingepland op dit moment" : null)"
                                    @onclick="() => ToggleDraftParticipant(participant.Id)">
                                @participant.Name
                                @if (alreadyAtTime)
                                {
                                    <small>al ingepland</small>
                                }
                            </button>
                            @if (playCount > 0)
                            {
                                var countTip = $"{participant.Name} heeft dit spel al {playCount} keer gespeeld in de afgelopen twee weken";
                                <span class="chip-badge chip-badge--count"
                                      tabindex="0"
                                      @onmousedown:stopPropagation="true"
                                      @onclick:stopPropagation="true"
                                      @onclick="() => ToggleCountBadge(countTip)"
                                      @onmouseenter="(e) => OnBadgeMouseEnter(e, countTip)"
                                      @onmouseleave="OnBadgeMouseLeave">
                                    @playCount
                                </span>
                            }
                            @if (conflicts.Count > 0)
                            {
                                var names = string.Join(", ", conflicts);
                                var warnTip = $"{participant.Name} staat op exclusief met: {names}";
                                <span class="chip-badge chip-badge--warn"
                                      tabindex="0"
                                      @onmousedown:stopPropagation="true"
                                      @onclick:stopPropagation="true"
                                      @onclick="() => ToggleWarnBadge(warnTip)"
                                      @onmouseenter="(e) => OnBadgeMouseEnter(e, warnTip)"
                                      @onmouseleave="OnBadgeMouseLeave">
                                    ⚠
                                </span>
                            }
                            @if (locationBlock)
                            {
                                var locTip = $"{participant.Name} mag niet naar {location}";
                                <span class="chip-badge chip-badge--warn"
                                      tabindex="0"
                                      @onmousedown:stopPropagation="true"
                                      @onclick:stopPropagation="true"
                                      @onclick="() => ToggleWarnBadge(locTip)"
                                      @onmouseenter="(e) => OnBadgeMouseEnter(e, locTip)"
                                      @onmouseleave="OnBadgeMouseLeave">
                                    ⚠
                                </span>
                            }
                        </span>
                    }
                </div>
            </section>

            @if (_badgeTooltip is not null)
            {
                <div class="@_badgeTooltipClass" role="alert">@_badgeTooltip</div>
            }

            @if (!string.IsNullOrWhiteSpace(_activityValidationMessage))
            {
                <div class="composer-warning" role="alert">@_activityValidationMessage</div>
            }

            <div class="composer-actions">
                <button class="composer-cancel-btn" type="button" @onclick="CloseActivityComposer">Annuleren</button>
                <button class="composer-save-btn" type="button" @onclick="() => SaveActivityFromComposer(location, slotIdx)">Opslaan</button>
            </div>
        </div>
    };

    private IEnumerable<SlotCard> CardsFor(string location, int slotIdx) =>
        _slots.Count > slotIdx
            ? _slots[slotIdx].Where(card => string.Equals(card.Location, location, StringComparison.OrdinalIgnoreCase))
            : [];

    private bool IsActiveCell(string location, int slotIdx) =>
        _activeCell is { } cell
        && cell.Slot == slotIdx
        && string.Equals(cell.Location, location, StringComparison.OrdinalIgnoreCase);

    private bool IsParticipantScheduledAtTime(string participantName, int slotIdx) =>
        _slots.Count > slotIdx
        && _slots[slotIdx].Any(card => card.Clients.Any(participant =>
            string.Equals(participant, participantName, StringComparison.OrdinalIgnoreCase)));

    private bool IsSupervisorScheduledAtTime(string supervisorName, int slotIdx) =>
        _slots.Count > slotIdx
        && _slots[slotIdx].Any(card => card.Supers.Any(s =>
            string.Equals(s.Name, supervisorName, StringComparison.OrdinalIgnoreCase)));

    private bool IsParticipantScheduledAnywhere(string participantName) =>
        _slots
            .SelectMany(slot => slot)
            .Any(card => card.Clients.Any(participant => string.Equals(participant, participantName, StringComparison.OrdinalIgnoreCase)));

    private bool IsSupervisorScheduledAnywhere(string supervisorName) =>
        _slots
            .SelectMany(slot => slot)
            .Any(card => card.Supers.Any(s =>
                string.Equals(s.Name, supervisorName, StringComparison.OrdinalIgnoreCase)));

    private bool IsPanelDragDropTarget(string location, int slotIdx) =>
        _panelDrag is not null && !IsPastDay;

    private bool IsLocationIncomplete(string location) =>
        !_slots.SelectMany(slot => slot).Any(card =>
            string.Equals(card.Location, location, StringComparison.OrdinalIgnoreCase) && card.Clients.Any());

    private bool IsOwnName(string name) =>
        Auth.CurrentUser?.Name is { } currentUserName
        && string.Equals(currentUserName, name, StringComparison.OrdinalIgnoreCase);

    private void ValidatePlanning()
    {
        for (var slotIdx = 0; slotIdx < _slots.Count; slotIdx++)
        {
            var clients = _slots[slotIdx].SelectMany(card => card.Clients);
            if (clients.GroupBy(client => client, StringComparer.OrdinalIgnoreCase).Any(group => group.Count() > 1))
            {
                _validationMessage = "Deze deelnemer is al ingepland op dit moment";
                return;
            }

            var supers = _slots[slotIdx].SelectMany(card => card.Supers.Select(s => s.Name));
            if (supers.GroupBy(s => s, StringComparer.OrdinalIgnoreCase).Any(group => group.Count() > 1))
            {
                _validationMessage = "Deze begeleider is al ingepland op dit moment";
                return;
            }
        }

        _validationMessage = null;
    }

    private List<string> BuildLocationOrder()
    {
        var locations = new List<string>();
        if (_builderData is not null)
            locations.AddRange(_builderData.Locaties.Select(location => location.Name));

        locations.AddRange(_slots.SelectMany(slot => slot)
            .Select(card => card.Location)
            .Where(location => !string.IsNullOrWhiteSpace(location)));

        return locations
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .DefaultIfEmpty("Zonder locatie")
            .ToList();
    }

    private static List<List<SlotCard>> NormalizeSlots(List<List<SlotCard>>? slots)
    {
        var normalized = EmptySlots();
        if (slots is null)
            return normalized;

        for (var i = 0; i < Math.Min(slots.Count, normalized.Count); i++)
            normalized[i] = slots[i] ?? [];

        return normalized;
    }

    private static List<List<SlotCard>> EmptySlots() =>
        Enumerable.Range(0, 4).Select(_ => new List<SlotCard>()).ToList();

    private static string AbsenceLabel(string type) => type switch
    {
        "ziek" => "Ziek",
        "vakantie" => "Vakantie",
        _ => "Afwezig"
    };

    private static string FormatPublishedDate(string key)
    {
        var days = new[] { "zo", "ma", "di", "wo", "do", "vr", "za" };
        var date = ParseDateKey(key);
        return $"{days[(int)date.DayOfWeek]} {date.Day}";
    }

    private static string FormatMonth(DateOnly date)
    {
        var months = new[] { "jan", "feb", "mrt", "apr", "mei", "jun", "jul", "aug", "sep", "okt", "nov", "dec" };
        return $"{months[date.Month - 1]} {date.Year}";
    }

    private static string NormalizeDateKey(string key) => ParseDateKey(key).ToString("yyyy-MM-dd");

    private static DateOnly ParseDateKey(string key)
    {
        if (TryParseDateKey(key, out var date))
            return date;

        throw new FormatException($"Invalid date key '{key}'.");
    }

    private static bool TryParseDateKey(string? key, out DateOnly date)
    {
        if (!string.IsNullOrWhiteSpace(key))
        {
            if (DateOnly.TryParse(key, out date))
                return true;

            if (DateTimeOffset.TryParse(key, out var dateTimeOffset))
            {
                date = DateOnly.FromDateTime(dateTimeOffset.LocalDateTime);
                return true;
            }

            if (DateTime.TryParse(key, out var dateTime))
            {
                date = DateOnly.FromDateTime(dateTime);
                return true;
            }
        }

        date = default;
        return false;
    }

