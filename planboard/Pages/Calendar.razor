    private void CloseActivityComposer()
    {
        _activeCell = null;
        _editCard = null;
        _draftGameId = null;
        _draftSupervisorIds = [];
        _draftParticipantIds = [];
        _activityValidationMessage = null;
        _pendingTagDrag = null;
        _badgeTooltip = null;
    }

    private async Task SaveActivityFromComposer(string location, int slotIdx)
    {
        var selectedGame = _builderData?.Spellen.FirstOrDefault(game => game.Id == _draftGameId);
        if (selectedGame is null)
        {
            _activityValidationMessage = "Selecteer eerst een spel";
            return;
        }

        var selectedSupers = AvailableSupervisors
            .Where(supervisor => _draftSupervisorIds.Contains(supervisor.Id))
            .Select(supervisor => new Supervisor { Name = supervisor.Name, Type = supervisor.Type })
            .ToList();
        if (!selectedSupers.Any())
        {
            _activityValidationMessage = "Selecteer minimaal een begeleider";
            return;
        }

        var selectedParticipants = AvailableParticipants
            .Where(participant => _draftParticipantIds.Contains(participant.Id))
            .ToList();
        if (!selectedParticipants.Any())
        {
            _activityValidationMessage = "Selecteer minimaal een deelnemer";
            return;
        }

        (int Slot, int CardIndex)? editInfo = _editCard is { } e && e.Slot == slotIdx ? e : null;
        var duplicateParticipant = selectedParticipants.FirstOrDefault(participant =>
            !(_pendingTagDrag is { Type: "client" } pd && string.Equals(pd.Value, participant.Name, StringComparison.OrdinalIgnoreCase))
            && _slots.Count > slotIdx && _slots[slotIdx]
                .Where((_, idx) => idx != editInfo?.CardIndex)
                .Any(card => card.Clients.Any(c => string.Equals(c, participant.Name, StringComparison.OrdinalIgnoreCase))));
        if (duplicateParticipant is not null)
        {
            _activityValidationMessage = "Deze deelnemer is al ingepland op dit moment";
            _validationMessage = _activityValidationMessage;
            Toast.Show(_activityValidationMessage);
            return;
        }

        var duplicateSupervisor = selectedSupers.FirstOrDefault(sup =>
            !(_pendingTagDrag is { Type: "supervisor" } pds && string.Equals(pds.Value, sup.Name, StringComparison.OrdinalIgnoreCase))
            && _slots.Count > slotIdx && _slots[slotIdx]
                .Where((_, idx) => idx != editInfo?.CardIndex)
                .Any(card => card.Supers.Any(s => string.Equals(s.Name, sup.Name, StringComparison.OrdinalIgnoreCase))));
        if (duplicateSupervisor is not null)
        {
            _activityValidationMessage = "Deze begeleider is al ingepland op dit moment";
            _validationMessage = _activityValidationMessage;
            Toast.Show(_activityValidationMessage);
            return;
        }

        var newCard = new SlotCard
        {
            Title = selectedGame.Name,
            Location = location,
            Clients = selectedParticipants.Select(participant => participant.Name).ToList(),
            Supers = selectedSupers
        };

        if (editInfo is { } edit)
        {
            _slots[slotIdx][edit.CardIndex] = newCard;
        }
        else
        {
            _slots[slotIdx].Add(newCard);
        }

        // Remove tag from source card if this was a drag-into-empty-slot
        if (_pendingTagDrag is not null)
        {
            var stillSelected = _pendingTagDrag.Type == "client"
                ? newCard.Clients.Any(c => string.Equals(c, _pendingTagDrag.Value, StringComparison.OrdinalIgnoreCase))
                : newCard.Supers.Any(s => string.Equals(s.Name, _pendingTagDrag.Value, StringComparison.OrdinalIgnoreCase));

            if (stillSelected)
            {
                var sourceCard = _slots[_pendingTagDrag.SlotIdx].FirstOrDefault(c =>
                    string.Equals(c.Location, _pendingTagDrag.SourceLocation, StringComparison.OrdinalIgnoreCase));
                if (sourceCard is not null)
                {
                    if (_pendingTagDrag.Type == "client")
                    {
                        var idx = sourceCard.Clients.FindIndex(c =>
                            string.Equals(c, _pendingTagDrag.Value, StringComparison.OrdinalIgnoreCase));
                        if (idx >= 0) sourceCard.Clients.RemoveAt(idx);
                    }
                    else
                    {
                        var sup = sourceCard.Supers.FirstOrDefault(s =>
                            string.Equals(s.Name, _pendingTagDrag.Value, StringComparison.OrdinalIgnoreCase));
                        if (sup is not null) sourceCard.Supers.Remove(sup);
                    }
                }
            }
        }

        CloseActivityComposer();
        _validationMessage = null;
        ValidatePlanning();
        _publishedAt = null;
        await SaveSlots();
        Toast.Show("Activiteit opgeslagen");
    }

