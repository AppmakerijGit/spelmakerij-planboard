    private async Task DropTag(string targetLocation, int slotIdx)
    {
        if (IsPastDay || _tagDrag is null) return;
        if (_tagDrag.Type is "client" or "supervisor" && IsAbsentOnSelectedDay(_tagDrag.Value))
        {
            Toast.Show($"{_tagDrag.Value} is afwezig en kan niet worden ingepland.");
            _tagDrag = null;
            return;
        }
        if (!CalendarDragHelper.TryDropTag(_slots, _tagDrag, targetLocation)) return;
        _tagDrag = null;
        ValidatePlanning();
        _publishedAt = null;
        StateHasChanged();
        await SaveSlots();
    }

    private bool IsValidTagDropTarget(string location, int slotIdx)
    {
        if (_tagDrag is null || IsPastDay) return false;
        if (_tagDrag.SlotIdx != slotIdx) return false;
        if (string.Equals(_tagDrag.SourceLocation, location, StringComparison.OrdinalIgnoreCase)) return false;
        if (_tagDrag.Type is "client" or "supervisor" && IsAbsentOnSelectedDay(_tagDrag.Value)) return false;

        var sourceCard = _slots[slotIdx].FirstOrDefault(c =>
            string.Equals(c.Location, _tagDrag.SourceLocation, StringComparison.OrdinalIgnoreCase));
        if (sourceCard is null) return false;

        return _tagDrag.Type switch
        {
            "client" => CardConstraints.CanRemoveClient(sourceCard),
            "supervisor" => CardConstraints.CanRemoveSupervisor(sourceCard),
            _ => true
        };
    }

    private bool IsDraggingTag(string type, string location, int slotIdx, string value) =>
        _tagDrag is { } d
        && d.Type == type
        && d.SlotIdx == slotIdx
        && string.Equals(d.SourceLocation, location, StringComparison.OrdinalIgnoreCase)
        && string.Equals(d.Value, value, StringComparison.OrdinalIgnoreCase);

