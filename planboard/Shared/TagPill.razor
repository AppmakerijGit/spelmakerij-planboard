@* Shared/TagPill.razor *@
<span class="tag @Type @(IsCurrentUser ? "own-name" : "")">@Label</span>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Type { get; set; } = "";
    [Parameter] public bool IsCurrentUser { get; set; }
}
